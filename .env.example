# Copy this file to .env and fill in your values.
# Do NOT commit the real .env to version control.

# Your Track-POD API key (Settings → Integrations → Web API → Add API Key)
TRACK_POD_API_KEY=your-api-key-here

# Flask secret key (used for session signing — change this to something random)
SECRET_KEY=change-me-in-production

# Optional: path to the local SQLite database
# DATABASE_PATH=deliver_it.db

# Optional: set to 1 to enable Flask debug mode
# FLASK_DEBUG=0

# Optional: port to listen on (default: 5000)
# PORT=5000
